# TrustLock — environment template (copy to .env; never commit real secrets)

# PayPal SANDBOX app credentials (test-only):
# https://developer.paypal.com/dashboard -> My Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_ENVIRONMENT=sandbox

# Optional: webhook ID for POST /api/paypal/webhooks signature verification
# (PayPal Developer dashboard -> Sandbox -> Webhooks, or POST /v1/notifications/webhooks)
PAYPAL_WEBHOOK_ID=

# PostgreSQL connection string
DATABASE_URL=postgresql://trustlock:trustlock@127.0.0.1:5432/trustlock

# AI verification agent (Phase 2). Gemini is free-tier:
# https://aistudio.google.com (or set OPENAI_API_KEY instead)
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=gemini-2.5-flash
